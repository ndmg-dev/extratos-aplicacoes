# =============================================================================
# Extratos de Aplicações — variáveis de ambiente (PRODUÇÃO / Coolify)
# =============================================================================
# No Coolify, defina estas variáveis na aba "Environment Variables" do recurso.
# NUNCA commite o .env com valores reais (está no .gitignore).
# Para desenvolvimento local, veja docker/ e backend/src/main/resources/application.yml.
# =============================================================================

# --- Domínio público (frontend) ---
# Usado para CORS e para montar o redirect do OAuth do Gmail.
PUBLIC_URL=https://aplicacoes.nucleodigital.cloud

# --- PostgreSQL ---
DB_NAME=extratos
DB_USER=extratos
# Gere uma senha forte: openssl rand -base64 36
DB_PASSWORD=CHANGE_ME

# --- Claude / Anthropic (chamada SÓ no backend) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Ingestão por e-mail (Gmail OAuth2) — §13 ---
EMAIL_ENABLED=true
# Credenciais do cliente OAuth (Google Cloud → Credenciais).
EMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EMAIL_CLIENT_SECRET=CHANGE_ME
# Deve bater EXATAMENTE com o "Authorized redirect URI" cadastrado no cliente OAuth.
EMAIL_REDIRECT_URI=https://aplicacoes.nucleodigital.cloud/api/email/oauth/callback
# Filtro exato por assunto + anexo PDF (aspas e acento são importantes).
EMAIL_QUERY=subject:"EXTRATO - APLICAÇÕES" has:attachment filename:pdf
# Intervalo do polling (ms). Padrão: 5 min.
EMAIL_POLL_INTERVAL_MS=300000
# Escopo OAuth: gmail (ler e-mails) + drive (arquivar PDFs). Reautorize ao mudar.
EMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/drive

# --- Arquivamento no Google Drive (pasta APLICAÇÕES → ANO/MÊS/CNPJ) ---
EMAIL_DRIVE_ENABLED=true
# ID da pasta "APLICAÇÕES" no Drive (da URL da pasta). A conta autorizada
# (docs.contabil) precisa ter acesso de edição a ela.
EMAIL_DRIVE_FOLDER_ID=CHANGE_ME
